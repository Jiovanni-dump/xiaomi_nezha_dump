					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_mosi_active {
				phandle = <0x8a>;

				mux {
					pins = "gpio49";
					function = "qup4_se0_l1";
				};

				config {
					pins = "gpio49";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_clk_active {
				phandle = <0x8c>;

				mux {
					pins = "gpio50";
					function = "qup4_se0_l2";
				};

				config {
					pins = "gpio50";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_cs_active {
				phandle = <0x8d>;

				mux {
					pins = "gpio51";
					function = "qup4_se0_l3";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_cs_sleep {
				phandle = <0x8f>;

				mux {
					pins = "gpio51";
					function = "gpio";
				};

				config {
					pins = "gpio51";
					drive-strength = <0x06>;
					bias-pull-up;
				};
			};

			mi_ts_spi_sleep {
				phandle = <0x8e>;

				mux {
					pins = "gpio48\0gpio49\0gpio50";
					function = "gpio";
				};

				config {
					pins = "gpio48\0gpio49\0gpio50";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};
		};
	};

