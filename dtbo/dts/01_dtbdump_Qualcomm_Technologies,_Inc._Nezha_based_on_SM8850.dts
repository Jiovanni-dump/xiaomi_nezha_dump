	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,pmd802x@4 {
				compatible = "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmd802x";
				};

				pmd802x-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x04 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x2d>;
				};

				pinctrl@8800 {
					compatible = "qcom,pmd802x-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0xc9>;

					sde_disp0_vdd_active {
						phandle = <0x163>;
						qcom,drive-strength = <0x02>;
						power-source = <0x02>;
						bias-disable;
						output-enable;
						input-disable;
						function = "normal";
						pins = "gpio2";
					};
				};

				amoled-ecm@f900 {
					compatible = "qcom,amoled-ecm";
					reg = <0xf900>;
					interrupt-names = "ecm-sdam0\0ecm-sdam1\0ecm-sdam2";
					nvmem-names = "amoled-ecm-sdam0\0amoled-ecm-sdam1\0amoled-ecm-sdam2";
					nvmem = <0x0e 0x0f 0x10>;
					interrupt-parent = <0xffffffff>;
					interrupts = <0x00 0xaa 0x01 0x01 0x00 0xab 0x01 0x01 0x00 0xac 0x01 0x01>;
					phandle = <0xca>;
				};

				qcom-amoled {
					compatible = "qcom,amoled-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					nvmem-cells = <0x11>;
					nvmem-cell-names = "ibb_spur_sqm_timer";
					status = "disabled";
					phandle = <0xcb>;

					ibb@f800 {
						reg = <0xf800>;
						reg-names = "ibb_base";
						regulator-name = "ibb";
						regulator-min-microvolt = "\0\f5";
						regulator-max-microvolt = <0x895440>;
						regulator-allow-set-load;
						qcom,swire-control;
						phandle = <0xcc>;
					};

					elvdd@f900 {
						reg = <0xf900>;
						reg-names = "ab_base";
						regulator-name = "ab";
						regulator-min-microvolt = <0x2625a0>;
						regulator-max-microvolt = <0x53ec60>;
						qcom,swire-control;
						phandle = <0xcd>;
					};

					oledb@fa00 {
						reg = <0xfa00>;
						reg-names = "oledb_base";
						regulator-name = "oledb";
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x7a1200>;
						qcom,swire-control;
						phandle = <0xce>;
					};
				};
			};

			qcom,pmih010x@7 {
				compatible = "qcom,spmi-pmic";
				reg = <0x07 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmih010x";
				};

				pmih010x-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x07 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x08 0x2703>;
					io-channel-names = "thermal";
					phandle = <0x23>;
				};

				pmih010x-temp-alarm-lite@c00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xc00>;
					interrupts = <0x07 0x0c 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x08 0x2718>;
					io-channel-names = "thermal";
					phandle = <0x2e>;
				};

				pinctrl@8800 {
					compatible = "qcom,pmih010x-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					pinctrl-0 = <0x12 0x13>;
					pinctrl-names = "default";
					phandle = <0x7f>;

					display_therm-default-state {
						pins = "gpio18";
						function = "normal";
						bias-high-impedance;
						phandle = <0x12>;
					};

					charger_therm-default-state {
						pins = "gpio12";
						function = "normal";
						bias-high-impedance;
						phandle = <0x13>;
					};

					anti_burn_mos_ctrl {

						anti_burn_mos_ctrl_default {
							pins = "gpio7";
							function = "normal";
							output-enable;
							power-source = <0x00>;
							phandle = <0x7e>;
						};
					};
				};

				eusb2-repeater@fd00 {
					compatible = "qcom,pmic-eusb2-repeater";
					reg = <0xfd00>;
					vdd18-supply = <0xffffffff>;
					vdd3-supply = <0xffffffff>;
					qcom,host-param-override-seq = <0x00 0x50 0x0e 0x51 0x04 0x52 0x07 0x53 0x05 0x54 0x03 0x55 0x03 0x56 0x03 0x57 0x02 0x58 0x03 0x59 0x03 0x5a 0x02 0x5b>;
					qcom,param-override-seq = <0x00 0x50 0x0e 0x51 0x01 0x52 0x07 0x53 0x03 0x54 0x00 0x55 0x00 0x56 0x06 0x57 0x02 0x58 0x03 0x59 0x01 0x5a 0x02 0x5b>;
					phandle = <0x33>;
				};

				qcom,hv-haptics@f000 {
					qcom,lra-f0-cal-count = <0x23a>;
					qcom,lra-f0-default = <0xaa>;
